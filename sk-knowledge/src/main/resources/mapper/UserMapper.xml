<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.skcto.skknowledge.mapper.UserMapper">

    <resultMap id="BaseResultMap" type="com.skcto.skknowledge.domain.User">
            <id property="id" column="id" />
            <result property="username" column="login_act" />
            <result property="password" column="login_pwd" />
            <result property="name" column="name" />
            <result property="phone" column="phone" />
            <result property="email" column="email" />
            <result property="accountNoExpired" column="account_no_expired" />
            <result property="credentialsNoExpired" column="credentials_no_expired" />
            <result property="accountNoLocked" column="account_no_locked" />
            <result property="accountEnabled" column="account_enabled" />
            <result property="createTime" column="create_time" />
            <result property="createBy" column="create_by" />
            <result property="updateTime" column="update_time" />
            <result property="updateBy" column="update_By" />
            <result property="lastLoginTime" column="last_login_time" />
    </resultMap>

    <sql id="Base_Column_List">
        id,login_act,login_pwd,name,phone,email,
        account_no_expired,credentials_no_expired,account_no_locked,account_enabled,create_time,
        create_by,update_time,update_By,last_login_time
    </sql>
</mapper>

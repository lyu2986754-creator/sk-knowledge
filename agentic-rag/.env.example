# 复制为 .env 后填写。

# 本服务监听端口
AGENTIC_PORT=8092

# 上游 Java RAG 服务
RAG_BASE_URL=http://127.0.0.1:8082

# LLM（DeepSeek，OpenAI 兼容）
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=CHANGE_ME
DEEPSEEK_MODEL=deepseek-chat

# Agent 循环最多几轮。超过则强制基于已有召回生成答案。
AGENT_MAX_STEPS=3

# 每轮检索返回多少条
AGENT_TOP_K=10

# 带回几轮对话历史（只用于消解追问里的指代，不参与生成）
AGENT_HISTORY_TURNS=4

# ---- 健壮性三件套 ----
# 一轮问答允许消耗的 token 上限（prompt + completion 跨步骤累加）。
# 超限则停止检索、用已有内容作答。**软上限**：超限那一轮仍会完整计费。
AGENT_TOKEN_BUDGET=12000

# 整轮问答的总时长上限（秒）。超时即整轮失败，前端可见。
AGENT_OVERALL_TIMEOUT=60

# 可恢复故障（超时 / 连接失败 / 5xx / 限流 / LLM 返回非法 JSON）的重试次数。
# 注意是"重试次数"，不是"总尝试次数"：2 表示最多尝试 3 次。
AGENT_MAX_RETRIES=2

# 首次重试前的等待秒数，之后按 2 的幂退避（1s、2s…）。
AGENT_RETRY_BACKOFF=1

# 调试用：设为 1 会把每轮的 LLM 决策打到日志
AGENT_DEBUG=0
